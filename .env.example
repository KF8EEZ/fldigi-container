# Copy to .env and edit.
FLDIGI_VERSION=4.2.13
FLMSG_VERSION=4.0.24
FLAMP_VERSION=2.2.14
FLWRAP_VERSION=1.3.6
# Use the stable by-id path so it survives replug/renumbering, e.g.:
#   ls /dev/serial/by-id/
DIGIRIG_SERIAL=/dev/ttyUSB0
# Your host uid (run `id -u`); needed for the pulse socket path.
UID=1000
